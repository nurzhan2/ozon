# ============================================================
# Переменные окружения для Railway.
# Скопируйте значения в Railway -> сервис -> Variables.
# ЭТОТ ФАЙЛ — ТОЛЬКО ШАБЛОН, реальные ключи сюда не вписывать.
# Готовую строку OZON_STORES соберёт скрипт:  python make_env.py
# ============================================================

# --- Магазины OZON: JSON одной строкой ---
OZON_STORES=[{"name":"НАЗВАНИЕ","client_id":"ЧИСЛО","api_key":"КЛЮЧ","perf_client_id":"...@advertising.performance.ozon.ru","perf_client_secret":"СЕКРЕТ"}]

# --- Google ---
# Содержимое JSON-ключа сервисного аккаунта целиком, одной строкой
GOOGLE_CREDENTIALS_JSON={"type":"service_account", ... }

# ID таблиц — из адресной строки:
# https://docs.google.com/spreadsheets/d/ЭТО_И_ЕСТЬ_ID/edit
GOOGLE_SHEET_CUMULATIVE=
GOOGLE_SHEET_DOD=
GOOGLE_SHEET_QUALITY=
GOOGLE_SHEET_STOCKS=
GOOGLE_SHEET_INTRADAY=

# Кому выдать доступ к созданным таблицам (через запятую)
GOOGLE_SHARE_WITH=
UPLOAD_TO_GOOGLE=1

# --- Поведение ---
ENABLE_PERFORMANCE=1
EXCLUDE_ARTICLE_MARKER=OUT
# 0 — накопительно с 1-го числа; 7 — скользящая неделя, как в образце
CUMULATIVE_DAYS=0
TIMEZONE=Europe/Moscow

# ОБЯЗАТЕЛЬНО на Railway: точка монтирования постоянного диска.
# Без него снимки для внутридневного сравнения теряются при перезапуске.
DATA_DIR=/data

# --- Расписание ---
MORNING_HOUR=8
INTRADAY_HOURS=8,10,12,14,16,18,20,22

# Разовый прогон сразу после деплоя — чтобы не ждать 8 утра.
# После проверки верните 0.
RUN_ON_START=0
RUN_ON_START_KIND=morning
